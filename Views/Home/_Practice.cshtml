@model IReadOnlyList<TestingStep>

<section class="section section--ink" id="practice" aria-labelledby="practice-title">
    <div class="container">
        <div class="row gy-5 gx-lg-5">
            <div class="col-lg-5">
                <h2 class="section-title" id="practice-title">How I check accessibility before release</h2>
                <p class="section-intro">
                    Automated tools find maybe a third of real problems. The rest shows up when you use the
                    screen the way people with disabilities do. This is the routine I run on every
                    customer-facing screen, and the one this site went through.
                </p>
                <p>
                    <a class="link-strong" asp-controller="Home" asp-action="Accessibility">Read this site's accessibility statement</a>
                </p>
            </div>
            <div class="col-lg-7">
                <ol class="checklist">
                    @foreach (var step in Model)
                    {
                        <li class="checklist__item">
                            <svg class="checklist__tick" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                                <circle cx="16" cy="16" r="14" />
                                <path d="m9.5 16.5 4.5 4.5 9-10" />
                            </svg>
                            <div>
                                <h3 class="checklist__title">@step.Title</h3>
                                <p>@step.Detail</p>
                            </div>
                        </li>
                    }
                </ol>
            </div>
        </div>
    </div>
</section>
